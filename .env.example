# === REQUIRED for Live ===
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_FALLBACK_URL=https://api.mainnet-beta.solana.com

# Opt-in live money path (desktop Live confirm also counts)
LIVE_TRADING=false

# Prefer desktop Hot Wallet. Optional CLI fallback (NEVER commit real key):
# PRIVATE_KEY=

# Risk: sniper | conservative | moderate | aggressive | paper
RISK_PROFILE=sniper

# Approx SOL/USD for liquidity enrichment from PumpPortal SOL amounts
SOL_PRICE_USD=150

# Paper sizing only (Live uses on-chain balance)
WALLET_BALANCE_SOL=1

# Mock feed — OFF by default. Set true only for offline unit smoke.
MOCK_FEED=false

# Build+simulate without broadcasting (safe live path testing)
DRY_RUN=false

# Optional Jito
# JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
# JITO_TIP_LAMPORTS=10000

# listen-live extras
# LISTEN_MS=45000
# DRY_BUILD_TX=true
